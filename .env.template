USE_LANGUAGE=
CITY=
# personality is short description about you (3-4 sentences). Write here your hobbies or personality type.
PERSONALITY=

OPENAI_API_KEY=
PUSHBULLET_API_KEY=
AIRTABLE_TOKEN=
AIRTABLE_WORKSPACE_ID=

# ── VPS Runner Settings ──────────────────────────────────────────────────
# Server host/port for the internal FastAPI server
VPS_SERVER_HOST=127.0.0.1
VPS_SERVER_PORT=8080

# Resource guard thresholds (percentage). The runner pauses/exits if exceeded.
VPS_RAM_THRESHOLD=80
VPS_DISK_THRESHOLD=90
VPS_RESOURCE_CHECK_INTERVAL=30

# Seconds to wait for the FastAPI server to start before giving up
VPS_SERVER_STARTUP_TIMEOUT=120

# Session scheduling — hours (24 h format) during which each session may run.
# A random minute within the range is chosen automatically each day.
SESSION1_HOUR_START=17
SESSION1_HOUR_END=18
SESSION2_HOUR_START=18
SESSION2_HOUR_END=19
SESSION3_HOUR_START=20
SESSION3_HOUR_END=21

# ── SMTP Email Notifications (port 25 is blocked — use 587 or 465) ──────
# Set SMTP_ENABLED=true to receive email alerts on failures and lifecycle events.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tindergpt@example.com
SMTP_TO=you@example.com
